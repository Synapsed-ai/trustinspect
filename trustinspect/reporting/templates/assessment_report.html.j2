<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data: file:; script-src 'none'; base-uri 'none'; form-action 'none'">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TrustInspect Assessment Report</title>
  <style>
    :root {
      --ti-blue-950: #06163c;
      --ti-blue-900: #071d4f;
      --ti-blue-800: #0b2f7a;
      --ti-blue-700: #0f49b7;
      --ti-green: #71ff5d;
      --ti-green-soft: #b8ffad;
      --ti-ink: #111827;
      --ti-muted: #64748b;
      --ti-card: #ffffff;
      --ti-page: #f5f7fb;
      --ti-line: #d9e2ef;
      --ti-red: #dc2626;
      --ti-yellow: #a16207;
      --ti-safe: #15803d;
      --ti-error: #475569;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      line-height: 1.5;
      color: var(--ti-ink);
      background:
        radial-gradient(circle at 18% 0%, rgba(113,255,93,0.16), transparent 34%),
        radial-gradient(circle at 84% 8%, rgba(102,227,255,0.13), transparent 30%),
        linear-gradient(180deg, #0b43ad 0, #0f49b7 310px, var(--ti-page) 310px, var(--ti-page) 100%);
    }
    .ti-page { max-width: 1160px; margin: 0 auto; padding: 24px 20px 56px; }
    .ti-cover { color: #fff; background: linear-gradient(135deg, rgba(7,29,79,.98) 0%, rgba(11,47,122,.98) 48%, rgba(3,18,45,.98) 100%); border: 1px solid rgba(113,255,93,.72); border-radius: 22px; overflow: hidden; box-shadow: 0 22px 60px rgba(2, 8, 23, .35), 0 0 0 1px rgba(113,255,93,.12) inset; position: relative; }
    .ti-cover::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 42px 42px; mask-image: linear-gradient(180deg, #000, transparent 82%); }
    .ti-cover-inner { position: relative; padding: 26px 30px 28px; }
    .ti-kicker { display: inline-flex; align-items: center; gap: 10px; padding: 6px 12px; border: 1px solid rgba(113,255,93,.55); border-radius: 999px; color: var(--ti-green); background: rgba(3, 18, 45, .46); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 800; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
    .ti-logo { margin: 18px 0 8px; color: var(--ti-green); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 1000; font-size: clamp(42px, 8.2vw, 104px); line-height: .85; letter-spacing: -.08em; text-shadow: 0 0 9px rgba(113,255,93,.50), 0 0 28px rgba(113,255,93,.28); }
    .ti-subtitle { max-width: 950px; margin: 0 0 12px; font-size: clamp(18px, 2.2vw, 28px); line-height: 1.18; font-weight: 750; letter-spacing: -.02em; color: #f8fbff; }
    .ti-byline { margin: 0 0 22px; color: #dbeafe; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; font-weight: 700; }
    .ti-dot { color: var(--ti-green); padding: 0 8px; }
    .ti-cover-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 18px; padding: 18px; border: 1px solid rgba(255,255,255,.16); border-radius: 16px; background: rgba(2, 8, 23, .38); backdrop-filter: blur(3px); }
    .ti-meta-item { min-width: 0; }
    .ti-meta-label { display: block; color: var(--ti-green-soft); font-size: 11px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 3px; }
    .ti-meta-value { color: #f8fbff; font-size: 14px; font-weight: 650; overflow-wrap: anywhere; }
    .engine-grid { margin-top: 14px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .engine-chip { border: 1px solid rgba(113,255,93,.22); border-radius: 12px; background: rgba(2,8,23,.28); padding: 8px 10px; color: #e9f8e9; font-size: 12px; }
    .engine-chip strong { color: var(--ti-green-soft); display: block; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
    .content { margin-top: 24px; }
    h1, h2, h3 { color: #0f172a; letter-spacing: -.02em; }
    h2 { font-size: 24px; margin: 0 0 14px; }
    h3 { margin-top: 0; }
    .summary, .section-card { background: var(--ti-card); border: 1px solid var(--ti-line); border-radius: 18px; padding: 20px; margin: 20px 0; box-shadow: 0 10px 28px rgba(15, 23, 42, .06); }
    .scanner-warning { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; border-radius: 14px; padding: 14px 16px; margin-top: 14px; font-weight: 650; }
    .scanner-ok { background: #ecfdf5; border: 1px solid #bbf7d0; color: #166534; border-radius: 14px; padding: 14px 16px; margin-top: 14px; font-weight: 650; }
    .metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 12px; }
    .metric { border: 1px solid var(--ti-line); border-radius: 14px; padding: 14px; background: #f8fafc; }
    .metric-label { color: var(--ti-muted); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
    .metric-value { margin-top: 4px; font-size: 28px; line-height: 1; font-weight: 900; color: #0f172a; }
    .metric.vuln .metric-value { color: var(--ti-red); }
    .metric.safe .metric-value { color: var(--ti-safe); }
    .metric.error .metric-value { color: var(--ti-error); }
    .metric.possible .metric-value { color: var(--ti-yellow); }
    .meta-lines { margin-top: 16px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 18px; font-size: 14px; }
    .meta-lines p { margin: 0; color: #334155; }
    .meta-lines strong { color: #0f172a; }
    .badge { display: inline-block; padding: 5px 9px; border-radius: 999px; font-size: 11px; font-weight: 900; letter-spacing: .03em; text-transform: uppercase; white-space: nowrap; }
    .vuln { background: #fee2e2; color: #991b1b; }
    .possible { background: #fef3c7; color: #92400e; }
    .safe { background: #dcfce7; color: #166534; }
    .error { background: #e2e8f0; color: #334155; }
    .adaptive, .dynamic { background: #dbeafe; color: #1e40af; }
    .baseline, .static { background: #ede9fe; color: #5b21b6; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .card { background: #f8fafc; border: 1px solid var(--ti-line); border-radius: 14px; padding: 14px; }
    .card p { margin-top: 0; }
    ul.compact { margin: 6px 0 0; padding-left: 20px; }
    table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 14px 0; overflow: hidden; border: 1px solid var(--ti-line); border-radius: 14px; }
    th, td { border-bottom: 1px solid var(--ti-line); padding: 11px 12px; vertical-align: top; text-align: left; }
    th { background: #111827; color: white; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
    tr:last-child td { border-bottom: 0; }
    td { background: #fff; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #0b1220; color: #e5f7e5; border: 1px solid #1f2937; padding: 12px; border-radius: 12px; max-height: 360px; overflow: auto; font-size: 12px; }
    details { margin-top: 10px; }
    summary { cursor: pointer; font-weight: 850; color: #0f49b7; }
    .muted { color: var(--ti-muted); font-size: 13px; }
    .small-table td, .small-table th { font-size: 13px; }
    .aitg-layer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
    .aitg-layer-card { border: 1px solid var(--ti-line); border-radius: 16px; padding: 14px; background: #f8fafc; }
    .aitg-layer-title { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; font-weight: 900; color: #0f172a; }
    .aitg-layer-title span { color: var(--ti-muted); font-size: 12px; font-weight: 800; }
    .aitg-layer-bar { display: flex; height: 14px; overflow: hidden; border-radius: 999px; background: #e2e8f0; margin: 12px 0 8px; border: 1px solid #dbe3ef; }
    .aitg-bar-vuln { background: #dc2626; min-width: 0; }
    .aitg-bar-possible { background: #f59e0b; min-width: 0; }
    .aitg-bar-safe { background: #16a34a; min-width: 0; }
    .aitg-bar-error { background: #64748b; min-width: 0; }
    .aitg-layer-legend { display: flex; flex-wrap: wrap; gap: 8px 12px; font-size: 12px; color: #334155; }
    .legend-dot { display: inline-block; width: 9px; height: 9px; border-radius: 999px; margin-right: 4px; }
    .dot-vuln { background: #dc2626; } .dot-possible { background: #f59e0b; } .dot-safe { background: #16a34a; } .dot-error { background: #64748b; }
    @media (max-width: 820px) { .ti-cover-meta, .metric-grid, .meta-lines, .grid, .aitg-layer-grid, .engine-grid { grid-template-columns: 1fr; } .ti-page { padding: 14px 12px 40px; } .ti-cover-inner { padding: 22px 18px; } }
  </style>
</head>
<body>
  <main class="ti-page">
    <section class="ti-cover">
      <div class="ti-cover-inner">
        <div class="ti-kicker">BlackHat Arsenal build</div>
        <div class="ti-logo">TRUSTINSPECT</div>
        <p class="ti-subtitle">Evidence-Based Trustworthy AI Testing for LLM and Agentic Applications</p>
        <p class="ti-byline">by Synapsed AI Lab <span class="ti-dot">●</span> Open Source License: Apache-2.0 <span class="ti-dot">●</span> v0.3-alpha</p>
        <div class="ti-cover-meta">
          <div class="ti-meta-item"><span class="ti-meta-label">Assessment</span><span class="ti-meta-value">{{ assessment.name }}</span></div>
          <div class="ti-meta-item"><span class="ti-meta-label">Target</span><span class="ti-meta-value">{{ assessment.target.name }}{% if assessment.target.url %} — {{ assessment.target.url }}{% endif %}</span></div>
          <div class="ti-meta-item"><span class="ti-meta-label">Suite</span><span class="ti-meta-value">{{ report.suite_name }}</span></div>
          <div class="ti-meta-item"><span class="ti-meta-label">Mode</span><span class="ti-meta-value">{{ report.assessment_mode }}</span></div>
          <div class="ti-meta-item"><span class="ti-meta-label">Started</span><span class="ti-meta-value">{{ report.started_human }}</span></div>
          <div class="ti-meta-item"><span class="ti-meta-label">Completed</span><span class="ti-meta-value">{{ report.completed_human }}</span></div>
          <div class="ti-meta-item"><span class="ti-meta-label">Duration</span><span class="ti-meta-value">{{ report.duration_human }}</span></div>
          <div class="ti-meta-item"><span class="ti-meta-label">Generation Strategy</span><span class="ti-meta-value">{{ report.generation_strategy }}</span></div>
        </div>
        <div class="engine-grid">
          {% for key, value in report.engine_versions.items() %}
            <div class="engine-chip"><strong>{{ key }}</strong>{{ value }}</div>
          {% endfor %}
        </div>
      </div>
    </section>

    <div class="content">
      <section class="summary">
        <h2>Executive Summary</h2>
        <div class="metric-grid">
          <div class="metric"><div class="metric-label">Total</div><div class="metric-value">{{ summary.total }}</div></div>
          <div class="metric"><div class="metric-label">Effective</div><div class="metric-value">{{ summary.effective_tests }}</div></div>
          <div class="metric vuln"><div class="metric-label">Vulnerabilities</div><div class="metric-value">{{ summary.vulnerabilities }}</div></div>
          <div class="metric error"><div class="metric-label">Errors</div><div class="metric-value">{{ summary.errors }}</div></div>
        </div>
        <div class="metric-grid">
          <div class="metric safe"><div class="metric-label">Safe</div><div class="metric-value">{{ summary.safe }}</div></div>
          <div class="metric possible"><div class="metric-label">Possible</div><div class="metric-value">{{ summary.possible }}</div></div>
          <div class="metric"><div class="metric-label">Static</div><div class="metric-value">{{ summary.static }}</div></div>
          <div class="metric"><div class="metric-label">Dynamic</div><div class="metric-value">{{ summary.dynamic }}</div></div>
        </div>
        <div class="meta-lines">
          <p><strong>Suite:</strong> {{ report.suite_name }}{% if report.suite_version != '-' %} <span class="muted">{{ report.suite_version }}</span>{% endif %}</p>
          <p><strong>Assessment Mode:</strong> {{ report.assessment_mode }}</p>
          <p><strong>Generation Strategy:</strong> {{ report.generation_strategy }}</p>
          {% if summary.dynamic %}<p><strong>Dynamic Tests:</strong> generated {{ report.generated_plan_summary.count }}, executed {{ summary.dynamic }}.</p>{% endif %}
          {% if report.target_profile_path != '-' %}<p><strong>Target Profile:</strong> {{ report.target_profile_path }}</p>{% endif %}
          {% if report.generated_tests_path != '-' %}<p><strong>Generated Tests:</strong> {{ report.generated_tests_path }}</p>{% endif %}
        </div>
        {% if report.scanner_status.level == 'ok' %}
          <div class="scanner-ok"><strong>Scanner Status:</strong> {{ report.scanner_status.message }}</div>
        {% elif report.scanner_status.message %}
          <div class="scanner-warning"><strong>Scanner Status:</strong> {{ report.scanner_status.message }}</div>
        {% endif %}
      </section>

      {% if report.target_profile %}
      <section class="summary">
        <h2>Target Capability Profile</h2>
        <div class="grid">
          <div class="card">
            <p><strong>Declared Identity</strong></p>
            <p>{{ report.target_profile.get('declared_identity', '-') }}</p>
            <p><strong>Inferred Domain:</strong> {{ report.target_profile.get('inferred_domain', '-') }}</p>
            <p><strong>Interaction Style:</strong> {{ report.target_profile.get('interaction_style', '-') }}</p>
          </div>
          <div class="card">
            <p><strong>Declared Capabilities</strong></p>
            <ul class="compact">{% for item in report.target_profile.get('declared_capabilities', []) %}<li>{{ item }}</li>{% endfor %}</ul>
          </div>
          <div class="card">
            <p><strong>Declared Boundaries</strong></p>
            <ul class="compact">{% for item in report.target_profile.get('declared_boundaries', []) %}<li>{{ item }}</li>{% endfor %}</ul>
          </div>
          <div class="card">
            <p><strong>Likely Sensitive Assets</strong></p>
            <ul class="compact">{% for item in report.target_profile.get('likely_sensitive_assets', []) %}<li>{{ item }}</li>{% endfor %}</ul>
          </div>
        </div>
        {% if report.target_profile.get('profiling_prompt') or report.target_profile.get('profiling_response') %}
        <details>
          <summary>Show profiling prompt and response</summary>
          {% if report.target_profile.get('profiling_prompt') %}<p><strong>Profiling prompt:</strong></p><pre>{{ report.target_profile.get('profiling_prompt') }}</pre>{% endif %}
          {% if report.target_profile.get('profiling_response') %}<p><strong>Profiling response:</strong></p><pre>{{ report.target_profile.get('profiling_response') }}</pre>{% endif %}
        </details>
        {% endif %}
      </section>
      {% endif %}

      {% if report.generated_plan_summary.count %}
      <section class="summary">
        <h2>Generated Test Plan Summary</h2>
        <p class="muted">Dynamic tests were generated deterministically from the target capability profile and selected static tests. The full generated plan is available at the end of the report and in the generated YAML artifact.</p>
        <div class="metric-grid">
          <div class="metric"><div class="metric-label">Generated</div><div class="metric-value">{{ report.generated_plan_summary.count }}</div></div>
          <div class="metric"><div class="metric-label">Parent Tests</div><div class="metric-value">{{ report.generated_plan_summary.parents_count }}</div></div>
          <div class="metric"><div class="metric-label">Static</div><div class="metric-value">{{ summary.static }}</div></div>
          <div class="metric"><div class="metric-label">Dynamic</div><div class="metric-value">{{ summary.dynamic }}</div></div>
        </div>
        <table class="small-table">
          <tr><th>Generated Dynamic Tests by OWASP AITG Layer</th><th>Count</th></tr>
          {% for layer, count in report.generated_plan_summary.by_aitg_layer %}<tr><td>{{ layer }}</td><td>{{ count }}</td></tr>{% endfor %}
        </table>
      </section>
      {% endif %}

      {% if report.is_aitg %}
      <section class="summary">
        <h2>OWASP AITG Impact Overview</h2>
        <p class="muted">This overview uses the official OWASP AI Testing Guide layers only: AI Application Testing, AI Model Testing, AI Infrastructure Testing, and AI Data Testing. It intentionally avoids generic trustworthiness dimensions in the summary.</p>
        <div class="aitg-layer-grid">
          {% for item in report.aitg_visual.layers %}
          {% if item.total %}
          <div class="aitg-layer-card">
            <div class="aitg-layer-title">{{ item.layer }} <span>{{ item.total }} checks</span></div>
            <div class="aitg-layer-bar" aria-label="{{ item.layer }} result distribution">
              <div class="aitg-bar-vuln" style="width: {{ item.findings_pct }}%"></div>
              <div class="aitg-bar-possible" style="width: {{ item.possible_pct }}%"></div>
              <div class="aitg-bar-safe" style="width: {{ item.safe_pct }}%"></div>
              <div class="aitg-bar-error" style="width: {{ item.errors_pct }}%"></div>
            </div>
            <div class="aitg-layer-legend">
              <span><i class="legend-dot dot-vuln"></i>{{ item.findings }} vuln</span>
              <span><i class="legend-dot dot-possible"></i>{{ item.possible }} possible</span>
              <span><i class="legend-dot dot-safe"></i>{{ item.safe }} safe</span>
              <span><i class="legend-dot dot-error"></i>{{ item.errors }} error</span>
            </div>
          </div>
          {% endif %}
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if report.is_aitg %}
      <section class="summary">
        <h2>OWASP AITG Coverage Matrix</h2>
        <table class="small-table">
          <tr><th>Layer</th><th>Total</th><th>Vulnerabilities</th><th>Possible</th><th>Safe</th><th>Errors</th></tr>
          {% for layer, counts in report.aitg_coverage.layers.items() %}
            {% if layer in ['AI Application Testing', 'AI Model Testing', 'AI Infrastructure Testing', 'AI Data Testing'] and counts.total %}
            <tr><td>{{ layer }}</td><td>{{ counts.total }}</td><td>{{ counts.findings }}</td><td>{{ counts.possible }}</td><td>{{ counts.safe }}</td><td>{{ counts.errors }}</td></tr>
            {% endif %}
          {% endfor %}
        </table>
        <details>
          <summary>Show coverage by AITG test ID</summary>
          <table class="small-table">
            <tr><th>AITG Test ID</th><th>OWASP AITG Layer</th><th>Static</th><th>Dynamic</th><th>Overall</th><th>Findings</th><th>Errors</th></tr>
            {% for row in report.aitg_coverage.tests %}
              {% if row.layer in ['AI Application Testing', 'AI Model Testing', 'AI Infrastructure Testing', 'AI Data Testing'] %}
              <tr><td>{{ row.test_id }}</td><td>{{ row.layer }}</td><td>{{ row.static }}</td><td>{{ row.dynamic }}</td><td>{{ row.result }}</td><td>{{ row.findings }}</td><td>{{ row.errors }}</td></tr>
              {% endif %}
            {% endfor %}
          </table>
        </details>
      </section>
      {% endif %}

      <section class="summary">
        <h2>Observations</h2>
        <p class="muted">Sorted by criticality. Original execution order is preserved in evidence filenames and the execution index field.</p>
        <table>
          <tr><th>Test</th><th>Source</th><th>{% if report.is_aitg %}OWASP AITG Layer{% else %}Suite Area{% endif %}</th><th>Classification</th><th>Confidence</th><th>Rationale / Evidence</th></tr>
          {% for row in report.observation_rows %}
          <tr>
            <td>{{ row.test_id }} — {{ row.test_name }}<div class="muted">Execution #{{ row.execution_index }}{% if row.parent_static_test_id != '-' %} · Parent: {{ row.parent_static_test_id }}{% endif %}</div></td>
            <td><span class="badge {{ row.source|lower }}">{{ row.source }}</span></td>
            <td>{{ row.layer }}</td>
            <td><span class="badge {{ row.classification_css }}">{{ row.classification }}</span></td>
            <td>{{ '%.2f'|format(row.confidence) }}</td>
            <td>
              {{ row.rationale }}
              <div class="muted">Execution time: {{ row.execution_time }}</div>
              <details><summary>Show prompt and response</summary>
                {% for ev in row.evidence %}
                  {% if ev.type in ['prompt', 'PROMPT', 'response', 'RESPONSE'] %}
                    <p><strong>{{ ev.type }}:</strong></p><pre>{{ ev.value }}</pre>
                  {% endif %}
                {% endfor %}
              </details>
              <details><summary>Show all evidence</summary>
                {% for ev in row.evidence %}<p><strong>{{ ev.type }}:</strong></p><pre>{{ ev.value }}</pre>{% endfor %}
              </details>
            </td>
          </tr>
          {% endfor %}
        </table>
      </section>

      {% if report.generated_plan %}
      <section class="summary">
        <details>
          <summary>Show full generated test plan</summary>
          <table class="small-table">
            <tr><th>Test</th><th>Parent AITG Test</th><th>OWASP AITG Layer</th><th>Selection Reason</th></tr>
            {% for row in report.generated_plan %}
            <tr>
              <td>{{ row.id }} — {{ row.name }}</td>
              <td>{{ row.parent_static_test_id }}</td>
              <td>{{ row.aitg_layer }}</td>
              <td>{{ row.reason }}</td>
            </tr>
            {% endfor %}
          </table>
        </details>
      </section>
      {% endif %}
    </div>
  </main>
</body>
</html>
