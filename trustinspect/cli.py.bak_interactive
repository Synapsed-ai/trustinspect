def cmd_detect_selectors(args: argparse.Namespace) -> None:
    ui = TerminalUI(enabled=not args.quiet_ui, show_banner=not args.no_banner)
    ui.banner(version=_trustinspect_version(), license_name=args.license_name)
    result = detect_selectors(args.target_url, wait_time=args.wait_time, headless=args.headless)
    print(json.dumps(result.to_dict(), indent=2, ensure_ascii=False))
    if result.input_selector and result.output_selector:
        print("\nSuggested scan command:\n")
        print(
            "trustinspect scan-web \\\n"
            f"  --target-url {json.dumps(args.target_url)} \\\n"
            f"  --input-selector {json.dumps(result.input_selector)} \\\n"
            f"  --output-selector {json.dumps(result.output_selector)} \\\n"
            "  --test-cases examples/test_cases/owasp_light_full.yaml \\\n"
            "  --output reports/web_scan.html \\\n"
            "  --headless"
        )


def cmd_profile_target(args: argparse.Namespace) -> None:
    ui = TerminalUI(enabled=not args.quiet_ui, show_banner=not args.no_banner)
    ui.banner(version=_trustinspect_version(), license_name=args.license_name)

    if args.profile_response_file:
        response = Path(args.profile_response_file).read_text(encoding="utf-8")
        profile = build_profile_from_response(args.target_url, response, target_name=args.target_name)
    else:
        input_selector, output_selector, frame_selector = _resolve_selectors(args)
        if not input_selector or not output_selector:
            raise SystemExit("profile-target requires --input-selector and --output-selector, unless --auto-selectors succeeds.")
        args.input_selector = input_selector
        args.output_selector = output_selector
        args.frame_selector = frame_selector
        profile = profile_target_via_web_ui(
            target_url=args.target_url,
            input_selector=input_selector,
            output_selector=output_selector,
            send_selector=args.send_selector,
            frame_selector=frame_selector,
            headless=args.headless,
            wait_time=args.wait_time,
            evidence_dir=Path(args.output).with_suffix("") / "evidence",
        )
        if args.target_name:
            profile.name = args.target_name

    save_target_profile(profile, args.output)
    print(f"[+] Target profile written to {args.output}")
    print(f"[+] Inferred domain: {profile.inferred_domain}")
    print(f"[+] Interaction style: {profile.interaction_style}")
    print(f"[+] Risk areas: {', '.join(profile.selected_risk_areas)}")


def cmd_generate_tests(args: argparse.Namespace) -> None:
    profile = load_target_profile(args.target_profile)
    tests = generate_contextual_tests(profile, max_tests=(args.max_dynamic_tests or args.max_tests))
    save_test_cases_yaml(
        tests,
        args.output,
        metadata={
            "generated_by": "trustinspect.template_generator",
            "target_profile": args.target_profile,
            "mode": "adaptive-template",
            "note": "Deterministic contextual test generation. No LLM used.",
        },
    )
    print(f"[+] Generated {len(tests)} contextual test cases: {args.output}")


def _run_web_assessment(
    args: argparse.Namespace,
    target: Target,
    test_cases: list[TestCase],
    output: str,
    ui: TerminalUI,
    metadata: dict | None = None,
) -> Assessment:
    evidence_dir = Path(output).with_suffix("") / "evidence"
    scanner = WebUiScanner(
        input_selector=args.input_selector,
        output_selector=args.output_selector,
        send_selector=getattr(args, "send_selector", None),
        frame_selector=getattr(args, "frame_selector", None),
        headless=getattr(args, "headless", True),
        wait_time=getattr(args, "wait_time", 20),
        evidence_dir=evidence_dir,
        progress_callback=ui.handle_event if not getattr(args, "quiet_ui", False) else None,
    )
    scan_started_at = now_utc()
    observations = scanner.run(target, test_cases)
    scan_completed_at = now_utc()

    assessment = Assessment(
        id=getattr(args, "assessment_id", None) or f"assessment-{target.id}",
        name=getattr(args, "name", None) or "TrustInspect Web UI Assessment",
        target=target,
        observations=observations,
        started_at=scan_started_at,
        completed_at=scan_completed_at,
        metadata=metadata or {},
    )
    _generate_findings(assessment)
    return assessment


def cmd_scan_web(args: argparse.Namespace) -> None:
    input_selector, output_selector, frame_selector = _resolve_selectors(args)
    if not input_selector or not output_selector:
        raise SystemExit("scan-web requires --input-selector and --output-selector, unless --auto-selectors succeeds.")
    args.input_selector = input_selector
    args.output_selector = output_selector
    args.frame_selector = frame_selector

    ui = TerminalUI(
        enabled=not args.quiet_ui,
        show_banner=not args.no_banner,
        show_full_prompt=args.show_full_prompt,
        show_full_response=args.show_full_response,
        prompt_chars=args.prompt_chars,
        response_chars=args.response_chars,
    )
    ui.banner(version=_trustinspect_version(), license_name=args.license_name)

    _apply_suite_selection(args, "test_cases")
    test_cases = _load_test_cases(args.test_cases)
    test_cases = _limit_test_cases(test_cases, getattr(args, "max_tests", None), label="scan-web test cases")
    if not test_cases:
        raise SystemExit(f"No test cases found in {args.test_cases}")

    target = Target(
        id=args.target_id or _safe_target_id(args.target_url),
        name=args.target_name or _target_name_from_url(args.target_url),
        url=args.target_url,
        target_type="web-ui",
        metadata={
            "scanner": "trustinspect.web_ui.selenium",
            "positioning": "Trustworthy AI behavior testing, not traditional web application security scanning.",
        },
    )

    ui.target_panel(args.target_url, target.name, args.test_cases, mode="web-ui")
    assessment = _run_web_assessment(
        args=args,
        target=target,
        test_cases=test_cases,
        output=args.output,
        ui=ui,
        metadata={
            "test_cases": str(args.test_cases),
            "scan_mode": "web-ui",
            "requested_max_tests": getattr(args, "max_tests", None),
            "executed_test_cases_count": len(test_cases),
            "wait_time_seconds": args.wait_time,
            "input_selector": input_selector,
            "output_selector": output_selector,
        },
    )
    _save_outputs(assessment, args.output, open_report=args.open)


def cmd_adaptive_scan(args: argparse.Namespace) -> None:
    input_selector, output_selector, frame_selector = _resolve_selectors(args)
    if not input_selector or not output_selector:
        raise SystemExit("adaptive-scan requires --input-selector and --output-selector, unless --auto-selectors succeeds.")
    args.input_selector = input_selector
    args.output_selector = output_selector
    args.frame_selector = frame_selector

    ui = TerminalUI(
        enabled=not args.quiet_ui,
        show_banner=not args.no_banner,
        show_full_prompt=args.show_full_prompt,
        show_full_response=args.show_full_response,
        prompt_chars=args.prompt_chars,
        response_chars=args.response_chars,
    )
    ui.banner(version=_trustinspect_version(), license_name=args.license_name)

    _apply_suite_selection(args, "base_test_cases")

    target_id = args.target_id or _safe_target_id(args.target_url)
    profile_output = Path(args.profile_output or f"reports/{target_id}_profile.yaml")
    generated_output = Path(args.generated_tests_output or f"reports/{target_id}_adaptive_tests.yaml")

    # 1. Profile target, or load existing profile.
    if args.target_profile:
        profile = load_target_profile(args.target_profile)
        print(f"[+] Loaded target profile: {args.target_profile}")
    else:
        print("[+] Profiling target capabilities with a benign profiling prompt...")
        profile = profile_target_via_web_ui(
            target_url=args.target_url,
            input_selector=input_selector,
            output_selector=output_selector,
            send_selector=args.send_selector,
            frame_selector=frame_selector,
            headless=args.headless,
            wait_time=args.wait_time,
            evidence_dir=profile_output.with_suffix("") / "evidence",
        )
        save_target_profile(profile, profile_output)
        print(f"[+] Target profile written to {profile_output}")

    # 2. Generate contextual tests.
    # Static baseline tests are always executed. The user-facing limit applies
    # only to dynamic/adaptive tests generated from the target profile.
    max_dynamic_tests = (
        getattr(args, "max_dynamic_tests", None)
        or getattr(args, "max_generated_tests", None)
        or 8
    )
    generated_tests_all = generate_contextual_tests(profile, max_tests=max_dynamic_tests)
    generated_tests_all = _normalize_test_cases_for_adaptive_pipeline(generated_tests_all)
    generated_tests = list(generated_tests_all)
    save_test_cases_yaml(
        generated_tests,
        generated_output,
        metadata={
            "generated_by": "trustinspect.template_generator",
            "target_profile": str(args.target_profile or profile_output),
            "mode": "adaptive-template",
            "note": "Deterministic contextual test generation. No LLM used.",
        },
    )
    print(f"[+] Generated {len(generated_tests)} adaptive tests: {generated_output}")

    # 3. Optional static baseline + dynamic generated tests.
    # Static tests are always executed. Dynamic tests are limited by
    # --max-dynamic-tests. Hidden legacy knobs are kept only for compatibility.
    baseline_tests_all: list[TestCase] = []
    if args.base_test_cases:
        baseline_tests_all = _load_test_cases(args.base_test_cases)
        # Advanced/backward-compatible hidden flag only. Normal users should not need it.
        baseline_tests_all = _limit_test_cases(
            baseline_tests_all,
            getattr(args, "max_baseline_tests", None),
            label="static baseline tests",
        )
        _mark_test_origin(baseline_tests_all, "baseline")
        print(f"[+] Loaded {len(baseline_tests_all)} static tests: {args.base_test_cases}")

    _mark_test_origin(generated_tests, "adaptive")

    baseline_tests, adaptive_tests_executed = _select_static_and_dynamic_tests(
        baseline_tests_all,
        list(generated_tests),
        max_dynamic_tests,
    )
    print(
        f"[+] Test plan: static={len(baseline_tests)} (all loaded), "
        f"dynamic={len(adaptive_tests_executed)} (limit={max_dynamic_tests})"
    )

    test_cases: list[TestCase] = []
    test_cases.extend(baseline_tests)
    test_cases.extend(adaptive_tests_executed)

    target_profile_dict = profile.to_dict()
    generated_test_plan = _generated_test_plan_from_cases(adaptive_tests_executed)

    target = Target(
        id=target_id,
        name=args.target_name or profile.name or _target_name_from_url(args.target_url),
        url=args.target_url,
        target_type="web-ui",
        metadata={
            "scanner": "trustinspect.web_ui.selenium",
            "assessment_mode": "adaptive",
