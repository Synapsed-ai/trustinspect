# TRUSTINSPECT_DYNAMIC_PER_STATIC_OVERRIDE
# This override implements the user-facing adaptive-scan semantics:
# static tests are executed all; dynamic tests are generated per static test.
def _profile_to_report_dict(profile):
    if profile is None:
        return {}
    if isinstance(profile, dict):
        return profile.get("target_profile", profile) if isinstance(profile.get("target_profile"), dict) else profile
    if hasattr(profile, "to_dict"):
        try:
            return profile.to_dict()
        except Exception:
            pass
    if hasattr(profile, "__dict__"):
        return dict(profile.__dict__)
    return {}


def _generated_test_plan_from_dynamic_per_static(test_cases: list[TestCase]) -> list[dict]:
    plan: list[dict] = []
    for tc in test_cases:
        meta = dict(getattr(tc, "metadata", {}) or {})
        risk_area = meta.get("risk_area") or meta.get("selected_risk_area") or "contextual_risk"
        parent_id = meta.get("parent_static_test_id") or "-"
        parent_name = meta.get("parent_static_test_name") or ""
        reason = meta.get("generation_reason") or (
            "Generated as a contextual variant of a static test using the target capability profile."
        )
        plan.append(
            {
                "id": tc.id,
                "name": tc.name,
                "category": tc.category,
                "risk_area": risk_area,
                "reason": reason,
                "parent_static_test_id": parent_id,
                "parent_static_test_name": parent_name,
                "dynamic_variant_index": meta.get("dynamic_variant_index"),
                "template_id": meta.get("template_id"),
            }
        )
    return plan


def cmd_adaptive_scan(args: argparse.Namespace) -> None:
    input_selector, output_selector, frame_selector = _resolve_selectors(args)
    if not input_selector or not output_selector:
        raise SystemExit("adaptive-scan requires --input-selector and --output-selector, unless --auto-selectors succeeds.")
    args.input_selector = input_selector
    args.output_selector = output_selector
    args.frame_selector = frame_selector

    ui = TerminalUI(
        enabled=not args.quiet_ui,
        show_banner=not args.no_banner,
        show_full_prompt=args.show_full_prompt,
        show_full_response=args.show_full_response,
        prompt_chars=args.prompt_chars,
        response_chars=args.response_chars,
    )
    ui.banner(version=_trustinspect_version(), license_name=args.license_name)

    if "_apply_suite_selection" in globals():
        _apply_suite_selection(args, "base_test_cases")

    target_id = args.target_id or _safe_target_id(args.target_url)
    profile_output = Path(args.profile_output or f"reports/{target_id}_profile.yaml")
    generated_output = Path(args.generated_tests_output or f"reports/{target_id}_adaptive_tests.yaml")

    # 1. Profile target, or load existing profile.
    if args.target_profile:
        profile = load_target_profile(args.target_profile)
        print(f"[+] Loaded target profile: {args.target_profile}")
    else:
        print("[+] Profiling target capabilities with a benign profiling prompt...")
        profile = profile_target_via_web_ui(
            target_url=args.target_url,
            input_selector=input_selector,
            output_selector=output_selector,
            send_selector=args.send_selector,
            frame_selector=frame_selector,
            headless=args.headless,
            wait_time=args.wait_time,
            evidence_dir=profile_output.with_suffix("") / "evidence",
        )
        save_target_profile(profile, profile_output)
        print(f"[+] Target profile written to {profile_output}")

    # 2. Load static tests. Static tests are always executed.
    baseline_tests_all: list[TestCase] = []
    if args.base_test_cases:
        baseline_tests_all = _load_test_cases(args.base_test_cases)
        _mark_test_origin(baseline_tests_all, "baseline")
        print(f"[+] Loaded {len(baseline_tests_all)} static tests: {args.base_test_cases}")
    else:
        print("[!] No static test suite/base-test-cases provided. Dynamic per-static generation will produce 0 dynamic tests.")

    # 3. Generate dynamic variants per static test.
    dynamic_tests_per_static = int(getattr(args, "dynamic_tests_per_static", 0) or 0)
    max_dynamic_tests = getattr(args, "max_dynamic_tests", None) or getattr(args, "max_generated_tests", None)

    generated_tests_all = generate_dynamic_tests_for_static_suite(
        static_tests=baseline_tests_all,
        target_profile=profile,
        dynamic_tests_per_static=dynamic_tests_per_static,
        max_dynamic_tests=max_dynamic_tests,
        template_dir="examples/dynamic_templates",
    )
    generated_tests = list(generated_tests_all)
    _mark_test_origin(generated_tests, "adaptive")

    save_test_cases_yaml(
        generated_tests,
        generated_output,
        metadata={
            "generated_by": "trustinspect.dynamic.per_static",
            "target_profile": str(args.target_profile or profile_output),
            "mode": "adaptive-per-static-template",
            "note": "Deterministic contextual test generation. No LLM used.",
            "dynamic_tests_per_static": dynamic_tests_per_static,
            "max_dynamic_tests": max_dynamic_tests,
            "static_tests_count": len(baseline_tests_all),
        },
    )
    print(
        f"[+] Generated {len(generated_tests)} dynamic tests: {generated_output} "
        f"(dynamic-per-static={dynamic_tests_per_static}, cap={max_dynamic_tests or 'none'})"
    )

    test_cases: list[TestCase] = []
    test_cases.extend(baseline_tests_all)
    test_cases.extend(generated_tests)

    target_profile_dict = _profile_to_report_dict(profile)
    generated_test_plan = _generated_test_plan_from_dynamic_per_static(generated_tests)

    target = Target(
        id=target_id,
        name=args.target_name or target_profile_dict.get("name") or _target_name_from_url(args.target_url),
        url=args.target_url,
        target_type="web-ui",
        metadata={
            "scanner": "trustinspect.web_ui.selenium",
            "assessment_mode": "adaptive",
            "generation_strategy": "per-static-deterministic-template",
            "target_profile": target_profile_dict,
            "positioning": "Trustworthy AI behavior testing, not traditional web application security scanning.",
        },
    )

    ui.target_panel(args.target_url, target.name, str(generated_output), mode="adaptive-web-ui")
    assessment = _run_web_assessment(
        args=args,
        target=target,
        test_cases=test_cases,
        output=args.output,
        ui=ui,
        metadata={
            "assessment_mode": "adaptive",
            "scan_mode": "adaptive-web-ui",
            "generation_strategy": "per-static-deterministic-template",
            "target_profile": target_profile_dict,
            "generated_test_plan": generated_test_plan,
            "target_profile_path": str(args.target_profile or profile_output),
            "generated_tests_path": str(generated_output),
            "base_test_cases": str(args.base_test_cases or getattr(args, "suite", "") or ""),
            "baseline_tests_count": len(baseline_tests_all),
            "static_tests_count": len(baseline_tests_all),
            "adaptive_tests_count": len(generated_tests),
            "dynamic_tests_count": len(generated_tests),
            "generated_tests_count": len(generated_tests),
            "dynamic_tests_generated_count": len(generated_tests),
            "executed_generated_tests_count": len(generated_tests),
            "dynamic_tests_executed_count": len(generated_tests),
            "dynamic_tests_per_static": dynamic_tests_per_static,
            "dynamic_per_static": dynamic_tests_per_static,
            "max_dynamic_tests": max_dynamic_tests,
            "dynamic_test_cap": max_dynamic_tests,
            "total_tests_count": len(test_cases),
            "test_budget_strategy": "static-all-plus-dynamic-per-static",
            "wait_time_seconds": args.wait_time,
            "input_selector": input_selector,
            "output_selector": output_selector,
        },
    )
    _save_outputs(assessment, args.output, open_report=args.open)

def _add_ui_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--no-banner", action="store_true", help="Disable the TrustInspect ASCII banner")
    parser.add_argument("--quiet-ui", action="store_true", help="Disable the live terminal UI and print only final paths")
    parser.add_argument("--license-name", default="Apache-2.0", help="License label printed in the CLI banner")


def _add_web_selector_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--target-url", required=True)
    parser.add_argument("--target-id", default=None)
    parser.add_argument("--target-name", default=None)
    parser.add_argument("--input-selector", default=None)
    parser.add_argument("--output-selector", default=None)
    parser.add_argument("--send-selector", default=None)
    parser.add_argument("--frame-selector", default=None)
    parser.add_argument("--auto-selectors", action="store_true")
    parser.add_argument("--wait-time", type=int, default=20)
    parser.add_argument("--headless", action="store_true")


def _add_live_output_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--show-full-prompt", action="store_true", help="Print full prompts in the live terminal UI")
    parser.add_argument("--show-full-response", action="store_true", help="Print full responses in the live terminal UI")
    parser.add_argument("--prompt-chars", type=int, default=420, help="Prompt snippet length in the live terminal UI")
    parser.add_argument("--response-chars", type=int, default=620, help="Response snippet length in the live terminal UI")


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="trustinspect",
        description="TrustInspect: Evidence-Based Trustworthy AI Testing",
    )
    sub = parser.add_subparsers(required=True)

    demo = sub.add_parser("demo-report", help="Generate a sample TrustInspect report")
    demo.add_argument("--output", default="reports/trustinspect_demo.html")
    demo.add_argument("--open", action="store_true", help="Open the HTML report after generation")
    demo.set_defaults(func=cmd_demo_report)

    imp = sub.add_parser("import-syninspect", help="Import SynInspect EDU JSON results")
    imp.add_argument("--input", required=True, help="SynInspect EDU JSON results")
    imp.add_argument("--output", default="reports/imported_syninspect.html")
    imp.add_argument("--target-id", default="target")
    imp.add_argument("--target-name", default="Imported SynInspect target")
    imp.add_argument("--target-url", default=None)
    imp.add_argument("--assessment-id", default="assessment-imported")
    imp.add_argument("--name", default="Imported SynInspect Assessment")
    imp.add_argument("--open", action="store_true", help="Open the HTML report after generation")
    imp.set_defaults(func=cmd_import_syninspect)

    detect = sub.add_parser("detect-selectors", help="Best-effort selector discovery for a Web UI target")
    detect.add_argument("--target-url", required=True)
    detect.add_argument("--wait-time", type=int, default=15)
    detect.add_argument("--headless", action="store_true")
    _add_ui_args(detect)
    detect.set_defaults(func=cmd_detect_selectors)

    profile = sub.add_parser("profile-target", help="Create a benign Target Capability Profile")
    _add_web_selector_args(profile)
    profile.add_argument("--output", default="profiles/target_profile.yaml")
    profile.add_argument("--profile-response-file", help="Build profile from a saved response instead of driving the browser")
    _add_ui_args(profile)
    profile.set_defaults(func=cmd_profile_target)

    generate = sub.add_parser("generate-tests", help="Generate deterministic contextual tests from a target profile")
    generate.add_argument("--target-profile", required=True)
    generate.add_argument("--output", required=True)
    generate.add_argument("--max-tests", type=int, default=8, help="Maximum number of generated contextual tests")
    generate.add_argument("--max-dynamic-tests", type=int, default=None, help="Alias for --max-tests")
    generate.set_defaults(func=cmd_generate_tests)

    web = sub.add_parser("scan-web", help="Execute TrustInspect test cases against a Web UI target")
    _add_web_selector_args(web)
    web.add_argument("--test-cases", default="examples/test_cases/owasp_light_full.yaml")
    web.add_argument("--suite", choices=available_suites(), default=None, help="Built-in static test suite to run, e.g. owasp-llm-top10-2025-light or owasp-llm-top10-2025-full")
    web.add_argument("--max-tests", type=int, default=None, help="Maximum number of static test cases to execute")
    web.add_argument("--output", default="reports/web_assessment.html")
    web.add_argument("--assessment-id", default=None)
    web.add_argument("--name", default=None)
    web.add_argument("--open", action="store_true", help="Open the HTML report after generation")
    _add_live_output_args(web)
    _add_ui_args(web)
    web.set_defaults(func=cmd_scan_web)

    adaptive = sub.add_parser("adaptive-scan", help="Profile target, generate contextual tests, then execute them")
    _add_web_selector_args(adaptive)
    adaptive.add_argument("--target-profile", help="Use an existing target profile instead of profiling the target")
    adaptive.add_argument("--profile-output", default=None, help="Where to write the generated target profile")
    adaptive.add_argument("--generated-tests-output", default=None, help="Where to write generated contextual test cases")
    adaptive.add_argument("--base-test-cases", default=None, help="Optional baseline tests to run before adaptive tests")
    adaptive.add_argument("--suite", choices=available_suites(), default=None, help="Built-in static suite to use as the adaptive-scan baseline. Static suite tests are executed before dynamic tests.")
    adaptive.add_argument("--dynamic-tests-per-static", "--dynamic-per-static", dest="dynamic_tests_per_static", type=int, default=0, help="Number of dynamic/contextual variants to generate for each static test. Static tests are always executed.")
    adaptive.add_argument("--max-dynamic-tests", type=int, default=None, help="Optional cap for the total number of dynamic tests generated/executed. Static tests are always executed.")
    # Backward-compatible alias. Hidden from help to keep the CLI simple.
    adaptive.add_argument("--max-generated-tests", type=int, default=None, help=argparse.SUPPRESS)
    adaptive.add_argument("--max-baseline-tests", type=int, default=None, help=argparse.SUPPRESS)
    adaptive.add_argument("--max-total-tests", type=int, default=None, help=argparse.SUPPRESS)
    adaptive.add_argument("--output", default="reports/adaptive_assessment.html")
    adaptive.add_argument("--assessment-id", default=None)
    adaptive.add_argument("--name", default=None)
    adaptive.add_argument("--open", action="store_true", help="Open the HTML report after generation")
    _add_live_output_args(adaptive)
    _add_ui_args(adaptive)
    adaptive.set_defaults(func=cmd_adaptive_scan)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
