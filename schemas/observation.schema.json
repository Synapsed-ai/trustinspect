{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustInspect Observation",
  "type": "object",
  "required": [
    "id",
    "target",
    "test_case",
    "classification",
    "confidence",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "SAFE",
        "POSSIBLE VULNERABILITY",
        "VULNERABILITY",
        "ERROR"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    }
  }
}
